{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
  ],
  enabledManagers: [
    "custom.regex",
  ],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["sdkcraft.yaml$"],
      matchStrings: [
        "version:\\s*'(?<currentValue>[0-9.]+)'",
      ],
      depNameTemplate: "mlflow/mlflow",
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver",
    },
  ],
}
